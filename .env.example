# ActaFlow - Motor de IA
# Copia este archivo como .env solo en tu maquina; nunca lo subas al repositorio.
# En Windows se recomienda guardar las variables como variables de usuario
# ([Environment]::SetEnvironmentVariable("NOMBRE", "valor", "User")).

# Secreto compartido con legal-case-service para firmar cada llamada gRPC (HMAC-SHA256 en
# los metadatos). Minimo 32 caracteres. Distinto en local y en produccion.
ACTAFLOW_ENGINE_HMAC_SECRET=

# Ventana de tolerancia del timestamp de la firma, en segundos.
ACTAFLOW_ENGINE_HMAC_TOLERANCE_SECONDS=300

# Entorno: local | produccion. En produccion se desactiva /docs.
ACTAFLOW_ENGINE_ENVIRONMENT=local

# Modelo de voz a texto activo: tiny | base | small.
ACTAFLOW_ENGINE_ASR_MODEL=tiny

# Carpeta donde viven los modelos de faster-whisper descargados.
# En Docker es /models. En local, por ejemplo, ./models
ACTAFLOW_ENGINE_MODELS_DIR=./models

# Audio en espanol usado por el benchmark de diagnostico.
ACTAFLOW_ENGINE_BENCHMARK_AUDIO=./muestras_generadas/muestra_es.wav

# Tiempo maximo por modelo dentro del benchmark, en segundos.
ACTAFLOW_ENGINE_BENCHMARK_TIMEOUT_SECONDS=600

# Servidor gRPC nativo (HTTP/2). La pasarela gRPC-Web del puerto web le reenvia las llamadas.
# En local, legal-case-service puede llamarlo directo en este puerto.
ACTAFLOW_ENGINE_GRPC_BIND=127.0.0.1:8102

# Tamano maximo del cuerpo de una peticion, en bytes (5 MB).
ACTAFLOW_ENGINE_MAX_BODY_BYTES=5242880
